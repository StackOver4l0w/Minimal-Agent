{
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}"
  },
  "presentation": {
    "echo": true,
    "reveal": "always",
    "focus": false,
    "panel": "shared",
    "showReuseMessage": false,
    "clear": true
  },
  "tasks": [
    {
      "label": "windows-i386-release",
      "type": "process",
      "command": "${workspaceFolder}\\.tools\\llvm-mingw\\bin\\i686-w64-mingw32-gcc.exe",
      "args": [
        "-O2",
        "-s",
        "-nostdlib",
        "-mno-sse",
        "-e",
        "entry",
        "-Wall",
        "-Wextra",
        "-Iinclude",
        "-Wl,/merge:.rdata=.text",
        "-Wl,/merge:.rodata=.text",
        "-o",
        "windows-i386.exe",
        "entry.c",
        "src/stack_probes.c",
        "src/environment.c",
        "src/main.c",
        "src/identity_headers.c",
        "src/transport.c",
        "src/shell.c",
        "src/report.c",
        "src/system_facts.c",
        "src/winhttp_api.c",
        "src/ntdll.c",
        "src/kernel32.c",
        "src/advapi.c",
        "src/string.c",
        "src/logfmt.c",
        "src/memory.c",
        "src/peb.c",
        "src/system.c",
        "src/djb2.c",
        "src/logger.c"
      ],
      "problemMatcher": ["$gcc"],
      "group": "build"
    },
    {
      "label": "windows-x86_64-release",
      "type": "process",
      "command": "${workspaceFolder}\\.tools\\llvm-mingw\\bin\\x86_64-w64-mingw32-gcc.exe",
      "args": [
        "-O2",
        "-s",
        "-nostdlib",
        "-e",
        "entry",
        "-Wall",
        "-Wextra",
        "-Iinclude",
        "-Wl,/merge:.rdata=.text",
        "-Wl,/merge:.rodata=.text",
        "-o",
        "windows-x86_64.exe",
        "entry.c",
        "src/stack_probes.c",
        "src/environment.c",
        "src/main.c",
        "src/identity_headers.c",
        "src/transport.c",
        "src/shell.c",
        "src/report.c",
        "src/system_facts.c",
        "src/winhttp_api.c",
        "src/ntdll.c",
        "src/kernel32.c",
        "src/advapi.c",
        "src/string.c",
        "src/logfmt.c",
        "src/memory.c",
        "src/peb.c",
        "src/system.c",
        "src/djb2.c",
        "src/logger.c"
      ],
      "problemMatcher": ["$gcc"],
      "group": "build"
    },
    {
      "label": "windows-aarch64-release",
      "type": "process",
      "command": "${workspaceFolder}\\.tools\\llvm-mingw\\bin\\aarch64-w64-mingw32-gcc.exe",
      "args": [
        "-O2",
        "-s",
        "-nostdlib",
        "-e",
        "entry",
        "-Wall",
        "-Wextra",
        "-Iinclude",
        "-Wl,/merge:.rdata=.text",
        "-Wl,/merge:.rodata=.text",
        "-o",
        "windows-aarch64.exe",
        "entry.c",
        "src/stack_probes.c",
        "src/environment.c",
        "src/main.c",
        "src/identity_headers.c",
        "src/transport.c",
        "src/shell.c",
        "src/report.c",
        "src/system_facts.c",
        "src/winhttp_api.c",
        "src/ntdll.c",
        "src/kernel32.c",
        "src/advapi.c",
        "src/string.c",
        "src/logfmt.c",
        "src/memory.c",
        "src/peb.c",
        "src/system.c",
        "src/djb2.c",
        "src/logger.c"
      ],
      "problemMatcher": ["$gcc"],
      "group": "build"
    },
    {
      "label": "windows-i386-debug",
      "type": "process",
      "command": "${workspaceFolder}\\.tools\\llvm-mingw\\bin\\i686-w64-mingw32-gcc.exe",
      "args": [
        "-O0",
        "-g",
        "-nostdlib",
        "-mno-sse",
        "-e",
        "entry",
        "-Wall",
        "-Wextra",
        "-DLOGGING_ENABLED",
        "-Iinclude",
        "-Wl,/merge:.rdata=.text",
        "-Wl,/merge:.rodata=.text",
        "-o",
        "windows-i386-debug.exe",
        "entry.c",
        "src/stack_probes.c",
        "src/environment.c",
        "src/main.c",
        "src/identity_headers.c",
        "src/transport.c",
        "src/shell.c",
        "src/report.c",
        "src/system_facts.c",
        "src/winhttp_api.c",
        "src/ntdll.c",
        "src/kernel32.c",
        "src/advapi.c",
        "src/string.c",
        "src/logfmt.c",
        "src/memory.c",
        "src/peb.c",
        "src/system.c",
        "src/djb2.c",
        "src/logger.c"
      ],
      "problemMatcher": ["$gcc"],
      "group": "build"
    },
    {
      "label": "windows-x86_64-debug",
      "type": "process",
      "command": "${workspaceFolder}\\.tools\\llvm-mingw\\bin\\x86_64-w64-mingw32-gcc.exe",
      "args": [
        "-O0",
        "-g",
        "-nostdlib",
        "-e",
        "entry",
        "-Wall",
        "-Wextra",
        "-DLOGGING_ENABLED",
        "-Iinclude",
        "-Wl,/merge:.rdata=.text",
        "-Wl,/merge:.rodata=.text",
        "-o",
        "windows-x86_64-debug.exe",
        "entry.c",
        "src/stack_probes.c",
        "src/environment.c",
        "src/main.c",
        "src/identity_headers.c",
        "src/transport.c",
        "src/shell.c",
        "src/report.c",
        "src/system_facts.c",
        "src/winhttp_api.c",
        "src/ntdll.c",
        "src/kernel32.c",
        "src/advapi.c",
        "src/string.c",
        "src/logfmt.c",
        "src/memory.c",
        "src/peb.c",
        "src/system.c",
        "src/djb2.c",
        "src/logger.c"
      ],
      "problemMatcher": ["$gcc"],
      "group": "build"
    },
    {
      "label": "Build All Windows",
      "detail": "release build of the three arches (CI matrix: i386/x86_64/aarch64)",
      "dependsOrder": "parallel",
      "dependsOn": [
        "windows-i386-release",
        "windows-x86_64-release",
        "windows-aarch64-release"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
